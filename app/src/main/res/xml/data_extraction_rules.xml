<?xml version="1.0" encoding="utf-8"?>
<!-- Cloud backup stays disabled. On devices that transfer apps despite
     allowBackup=false, transfer only the private draft and pen preferences. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="documents/" />
        <include domain="sharedpref" path="pen.xml" />
    </device-transfer>
</data-extraction-rules>
